{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true
  },
  "include": ["*.ts", "*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules"]
}
